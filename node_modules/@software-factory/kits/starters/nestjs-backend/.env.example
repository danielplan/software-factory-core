# This backend's settings, read at start-up (src/common/environment.ts checks
# them). Copy this file to .env and change what differs on this computer.
#
# DATABASE_URL names the PostgreSQL database this backend keeps its data in:
# any server you choose, and a database of its own on it. This one is the
# local server of compose.yaml (`npm run db:start`); `npm run migrate` (and
# `npm start`) makes the database when it is missing.
DATABASE_URL=postgres://postgres:local-development-only@127.0.0.1:55432/new-backend
# Another database on the same server, in place of the one DATABASE_URL names:
# the factory sets it for a working copy, so the copy keeps its data apart.
DATABASE_NAME=
HOST=127.0.0.1
PORT=3000

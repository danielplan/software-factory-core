{
  "name": "new-phone-app",
  "packageManager": "npm@11.19.0",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && depcruise src prototype",
    "deadcode": "knip",
    "duplicates": "jscpd src",
    "format": "prettier --write src test prototype scripts *.json *.jsonc *.cjs *.ts README.md .dependency-cruiser.cjs .jscpd.json",
    "format:check": "prettier --check src test prototype scripts *.json *.jsonc *.cjs *.ts README.md .dependency-cruiser.cjs .jscpd.json",
    "verify": "node scripts/verify.cjs",
    "deps:check": "expo install --check --npm",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "prototype": "node --experimental-strip-types scripts/prototype.ts",
    "prototype:live": "node --experimental-strip-types scripts/live-prototype.ts",
    "prototype:phone": "node --experimental-strip-types scripts/prototype-phone.ts",
    "check:prototypes": "node --experimental-strip-types scripts/check-real-app.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.0.0",
    "expo": "~57.0.33",
    "expo-asset": "~57.0.0",
    "expo-build-properties": "~57.0.23",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.14",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.31",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.4",
    "react": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.13",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "expo-doctor": "^1.0.0",
    "globals": "^17.13.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "msw": "^2.15.0",
    "prettier": "^3.0.0",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "overrides": {
    "test-renderer": "1.2.0",
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

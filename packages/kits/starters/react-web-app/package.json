{
  "name": "new-web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 src test prototype scripts *.ts *.mjs .dependency-cruiser.cjs && depcruise src prototype",
    "deadcode": "knip",
    "duplicates": "jscpd src prototype",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prototype": "node --experimental-strip-types scripts/build-prototype.ts",
    "prototype:live": "node --experimental-strip-types scripts/live-prototype.ts",
    "format:check": "prettier --check src test prototype scripts *.ts *.json *.mjs knip.jsonc .jscpd.json .dependency-cruiser.cjs index.html",
    "format": "prettier --write src test prototype scripts *.ts *.json *.mjs knip.jsonc .jscpd.json .dependency-cruiser.cjs index.html",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run deadcode && npm run duplicates && npm run test:coverage && npm run build && npm run check:prototypes",
    "check:prototypes": "node --experimental-strip-types scripts/check-real-build.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.4",
    "lucide-react": "^1.54.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.1",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "msw": {
    "workerDirectory": [
      "prototype/public"
    ]
  }
}

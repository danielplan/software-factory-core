# This backend's settings, read at start-up (src/common/environment.ts checks
# them). Copy this file to .env and change what differs on this computer.
#
# DATABASE_URL names the PostgreSQL database this backend keeps its data in:
# any server you choose, and a database of its own on it. `npm run migrate`
# makes the database when it is missing. Without DATABASE_URL the backend uses
# postgres://127.0.0.1:5432/new-backend.
DATABASE_URL=postgres://postgres:replace_with_local_password@127.0.0.1:5432/new-backend
HOST=127.0.0.1
PORT=3000

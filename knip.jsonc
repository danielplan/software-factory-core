{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": { "entry": [], "project": [] },
    "packages/core": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/skills": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/knowledge-base": {
      "entry": ["bin/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts", "test/**/*.ts"],
    },
    "packages/kits": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/launcher": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/server": {
      "entry": ["bin/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts", "test/**/*.ts"],
    },
    "packages/dashboard": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"],
    },
  },
  "ignoreExportsUsedInFile": true,
  // shadcn's generated pieces are kept as generated, with all their parts.
  "ignoreIssues": {
    "packages/dashboard/src/components/ui/**": ["exports", "types"],
  },
}

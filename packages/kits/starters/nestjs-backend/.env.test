# The settings for `npm run test:integration`: copy this file to .env.test.
# The tests write to a database of their own, never the one in .env: each
# working copy of the code gets one, named after this one with a mark of its
# folder, made when missing on this server (the ones of copies that are gone
# are dropped).
DATABASE_URL=postgres://postgres:local-development-only@127.0.0.1:55432/new-backend-test

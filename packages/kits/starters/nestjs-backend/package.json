{
  "name": "new-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest build && node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env --experimental-strip-types scripts/reset.ts",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:check": "node --experimental-strip-types scripts/db-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --env-file=.env.test --experimental-strip-types test/run-integration.ts",
    "test-env:migrate": "node --env-file=.env.test --experimental-strip-types scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts *.config.ts && depcruise src",
    "deadcode": "knip",
    "duplicates": "jscpd src",
    "format": "prettier --write src test scripts *.json *.mjs *.ts *.md .dependency-cruiser.cjs",
    "format:check": "prettier --check src test scripts *.json *.mjs *.ts *.md .dependency-cruiser.cjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run deadcode && npm run duplicates && npm run db:check && npm test && npm run build"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "^2.0.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "nestjs-cls": "^7.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.5.8",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "light-my-request": "^6.8.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}

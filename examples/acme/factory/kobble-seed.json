  "realProblems": [
    {
      "id": "r_mia",
      "persona": "mia",
      "title": "Shopping has to fit into the gaps of a busy day",
      "description": "Mia shops in short moments: on the tram, after dinner. Anything that needs one sitting, or a time she isn’t free, fails her.",
      "by": "Pia"
    },
    {
      "id": "r_bruno",
      "persona": "bruno",
      "title": "Ordering is paperwork that keeps him from baking",
      "description": "Every minute in the back office is a minute not baking. He wants supplies handled, not managed.",
      "by": "kobold"
    },
    {
      "id": "r_noah",
      "persona": "noah",
      "title": "He doesn’t trust a shop he hasn’t used yet",
      "description": "Every doubt, about the size or whether the order went through, is a reason to leave or send it back.",
      "by": "kobold"
    }
  ],
